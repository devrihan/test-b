# Keycloak Configuration
NEXT_PUBLIC_KEYCLOAK_URL=http://localhost:8180
NEXT_PUBLIC_KEYCLOAK_REALM=inferentics-realm
NEXT_PUBLIC_KEYCLOAK_CLIENT_ID=react-app
NEXT_PUBLIC_AGGREGATED_DATA_API_URL=http://localhost:8082

# Keycloak Admin (server side only)
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=admin

NEXT_PUBLIC_API_URL=http://localhost:8082

NEXT_PUBLIC_BEAVER_API_URL=http://localhost:4000


OPENAI_API_KEY=your_openai_key
ANTHROPIC_API_KEY=your_claude_key
GEMINI_API_KEY=your_gemini_key

# Scanning screen (/scans) — piper intake API, server-side only (never NEXT_PUBLIC)
PIPER_INTAKE_URL=http://localhost:3005
PIPER_INTAKE_TOKEN=your_piper_service_token
# Base URL the /api/scans/images proxy streams page images from (piper has no
# image-serving endpoint yet — this points at the R2 bucket's public base).
SCAN_IMAGE_BASE=
